{
  "URLBlocklist": [
    "*"
  ],
  "URLAllowlist": [
    "spotify.com",
    "scdn.co",
    "spotifycdn.com",
    "pscdn.co",
    "spotifycdn.net",
    "spotify.net",
    "www.google.com/recaptcha/",
    "www.gstatic.com/recaptcha/",
    "www.recaptcha.net/recaptcha/",
    "hcaptcha.com",
    "newassets.hcaptcha.com",
    "accounts.google.com",
    "ssl.gstatic.com",
    "fonts.gstatic.com",
    "lh3.googleusercontent.com",
    "www.facebook.com",
    "m.facebook.com",
    "static.xx.fbcdn.net",
    "appleid.apple.com",
    "appleid.cdn-apple.com",
    "idmsa.apple.com",
    "about:blank",
    "blob:*",
    "data:*"
  ],
  "CookiesAllowedForUrls": [
    "https://[*.]google.com,https://accounts.spotify.com",
    "https://[*.]gstatic.com,https://accounts.spotify.com",
    "https://[*.]recaptcha.net,https://accounts.spotify.com",
    "https://[*.]hcaptcha.com,https://accounts.spotify.com",
    "https://[*.]facebook.com,https://accounts.spotify.com",
    "https://[*.]apple.com,https://accounts.spotify.com",
    "https://[*.]scdn.co,https://open.spotify.com",
    "https://[*.]spotifycdn.com,https://open.spotify.com"
  ],
  "DownloadRestrictions": 3,
  "AllowFileSelectionDialogs": false,
  "PrintingEnabled": false,
  "PasswordManagerEnabled": false,
  "AutofillAddressEnabled": false,
  "AutofillCreditCardEnabled": false,
  "BrowserSignin": 0,
  "SyncDisabled": true,
  "BrowserGuestModeEnabled": false,
  "BrowserAddPersonEnabled": false,
  "IncognitoModeAvailability": 1,
  "ExtensionInstallBlocklist": [
    "*"
  ],
  "BlockExternalExtensions": true,
  "TranslateEnabled": false,
  "MetricsReportingEnabled": false,
  "BackgroundModeEnabled": false,
  "DefaultNotificationsSetting": 2,
  "DefaultGeolocationSetting": 2,
  "AudioCaptureAllowed": false,
  "VideoCaptureAllowed": false,
  "ScreenCaptureAllowed": false,
  "DefaultWebBluetoothGuardSetting": 2,
  "DefaultWebUsbGuardSetting": 2,
  "DefaultSerialGuardSetting": 2,
  "DefaultWebHidGuardSetting": 2,
  "PromotionalTabsEnabled": false,
  "ShowFullUrlsInAddressBar": true
}