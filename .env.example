# Generate the real file with scripts/setup.sh (it creates random secrets). All keys:
SITE_ADDRESS=music.example.com
CADDY_CONFIG=Caddyfile.http
CADDY_TLS=internal
HTTPS_BIND=127.0.0.1
TRUST_PROXY=2
COOKIE_SECURE=auto
PUBLIC_ORIGIN=https://music.example.com
TZ=Europe/Istanbul
CONTROL_SECRET=change-me-64-random-characters
SETUP_TOKEN=change-me
LOCAL_LOGIN=true
OIDC_ISSUER=https://auth.example.com/application/o/reddify-web/
OIDC_CLIENT_ID=reddify-web
OIDC_CLIENT_SECRET=
OIDC_LABEL=authentik
OIDC_ADMIN_GROUP=authentik Admins
OIDC_APP_ISSUER=https://auth.example.com/application/o/reddify-android/
OIDC_APP_CLIENT_ID=reddify-android
MAX_USERS=10
MAX_PARALLEL_DOWNLOADS=3
BROWSER_IDLE_MINUTES=120
